# Dependencies
node_modules/

# Environment secrets — NEVER commit
.env
.env.*
!.env.example

# Database files — contain live data, excluded from VCS
*.db
*.sqlite
*.db-journal
database/*.db
server/*.db

# Uploaded files — marketing PDFs/images ARE committed so GitHub Pages can serve them
# Only exclude the raw broker photos and temp files
uploads/brokers/
!uploads/
!uploads/.gitkeep

# OS / editor noise
.DS_Store
*.log
