# ============================================
# WALMART REAL ESTATE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ============= SECURITY =============
# JWT Secret - Generate a strong random string (minimum 64 characters)
# Example: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-MUST-be-32-plus-characters-long
# ⚠️  Server will refuse to start if this is missing or < 32 chars.

# Environment: development | production
NODE_ENV=development

# ============= SERVER =============
# Server port (default: 3000)
PORT=3000

# ============= CORS =============
# Comma-separated list of allowed origins (no trailing slashes)
# Example: https://walmartrealty.github.io,https://yourdomain.com
ALLOWED_ORIGINS=https://walmartrealty.github.io

# ============= ADMIN NETWORK ALLOWLIST =============
# Comma-separated IPv4 CIDR blocks allowed to reach /admin and /api/auth.
# Requests from any other IP receive HTTP 403 before auth is even attempted.
#
# HOW TO GET THESE VALUES:
#   Contact the Walmart Network / InfoSec team for the authoritative
#   Eagle WiFi and corporate VPN CIDR ranges.
#
# Local development — localhost is always permitted automatically.
# Production example (replace with real Walmart network ranges):
#   ALLOWED_ADMIN_CIDRS=10.32.0.0/11,10.64.0.0/10,172.16.0.0/12
#
ALLOWED_ADMIN_CIDRS=127.0.0.1/32

# ============= EMAIL (Optional) =============
# SMTP configuration for LOI notifications
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@walmart.com
SMTP_PASS=your-email-password
SMTP_FROM=realestate@walmart.com

# ============= DATABASE =============
# SQLite database path (default: ./walmart-realty.db)
DATABASE_PATH=./walmart-realty.db

# ============= ADMIN =============
# Initial admin credentials (only used on first run)
# Change the password immediately after first login!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!@#

# ============= LOGGING =============
# Log level: debug | info | warn | error
LOG_LEVEL=info
